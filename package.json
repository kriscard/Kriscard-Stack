{
  "name": "kriscard-stack",
  "version": "0.0.0",
  "private": true,
  "description": "Skill-first engineering workflows launched through native Pi.",
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @kriscard/kstack build",
    "test": "vitest run",
    "typecheck": "pnpm --filter @kriscard/kstack typecheck",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "pnpm run lint && pnpm run build && pnpm test && pnpm run typecheck && pnpm run format:check",
    "kstack": "node --enable-source-maps packages/pi-runner/dist/bin.js",
    "kriscard": "node --enable-source-maps packages/pi-runner/dist/bin.js"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.87.0",
    "@types/node": "24.10.0",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.34.4"
}
