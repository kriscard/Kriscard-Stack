{
  "name": "@kriscard/control-plane",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./artifacts": {
      "types": "./dist/artifacts/index.d.ts",
      "import": "./dist/artifacts/index.js"
    }
  },
  "scripts": {
    "build": "pnpm --filter @kriscard/core build && tsc -p tsconfig.json",
    "test": "pnpm run build && pnpm --dir ../.. exec vitest run packages/control-plane/test",
    "typecheck": "pnpm --filter @kriscard/core build && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@earendil-works/chord": "1.1.0",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-durable": "1.1.0",
    "@kriscard/core": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "typescript": "7.0.2"
  }
}
