{
  "name": "@kriscard/kstack",
  "version": "0.1.0",
  "description": "Interactive Pi workflows with a Pi Durable execution backend.",
  "bin": {
    "kriscard": "dist/bin.js",
    "kstack": "dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/launcher.d.ts",
      "import": "./dist/launcher.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json && node -e \"require('node:fs').cpSync('../../skills/dev','dist/skills',{recursive:true})\"",
    "start": "node --enable-source-maps dist/bin.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@earendil-works/chord": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-durable": "1.4.0",
    "fs-ext": "2.1.1"
  },
  "devDependencies": {
    "@types/fs-ext": "2.0.3",
    "@types/node": "24.10.0",
    "typescript": "7.0.2"
  }
}
