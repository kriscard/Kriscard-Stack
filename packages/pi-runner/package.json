{
  "name": "@kriscard/kstack",
  "version": "0.1.3",
  "description": "Native Pi launcher with Kriscard workflow skills.",
  "bin": {
    "kriscard": "dist/bin.js",
    "kstack": "dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/launcher.d.ts",
      "import": "./dist/launcher.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json && node -e \"require('node:fs').cpSync('../../skills/dev','dist/skills',{recursive:true})\"",
    "start": "node --enable-source-maps dist/bin.js",
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@earendil-works/chord": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-durable": "1.4.0",
    "@opentui/core": "0.7.0",
    "web-tree-sitter": "0.25.10"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  },
  "pi": {
    "extensions": [
      "dist/roles-extension.js"
    ],
    "skills": [
      "dist/skills"
    ]
  }
}
